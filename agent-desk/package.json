{
  "name": "agent-desk",
  "productName": "Agent Desk",
  "version": "2.3.2",
  "description": "Кто из ИИ-агентов работает, кто ждёт ответа и что нужно переслать",
  "author": "jayleywesa",
  "license": "MIT",
  "private": true,
  "main": "desktop/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test --test-reporter=spec core/test/*.test.js",
    "assets": "node scripts/fetch-assets.js",
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64 --publish never",
    "mobile:web": "node scripts/prepare-mobile.js"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "app.agentdesk.desktop",
    "productName": "Agent Desk",
    "copyright": "Agent Desk",
    "directories": {
      "output": "dist"
    },
    "files": [
      "package.json",
      "core/desk.js",
      "core/peers.js",
      "core/sync.js",
      "core/tasks.js",
      "core/mail.js",
      "core/agent-client.js",
      "core/cli.js",
      "core/mcp.js",
      "desktop/**",
      "web/**",
      "!web/**/*.md"
    ],
    "extraFiles": [
      { "from": "desktop/agentdesk.cmd", "to": "agentdesk.cmd" },
      { "from": "desktop/agentdesk-mcp.cmd", "to": "agentdesk-mcp.cmd" }
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "desktop/icon.ico",
      "artifactName": "AgentDesk-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Agent Desk",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049"
    }
  },
  "overrides": {
    "minimatch@>=7.0.0 <=11.0.0": "11.0.8"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "qrcode": "^1.5.4",
    "zod": "4.6.7"
  }
}
